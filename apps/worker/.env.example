# =============================================================================
# @alyora/worker - variables d'environnement
# Copier ce fichier en .env pour le développement local. Ne jamais commiter de vraie valeur.
# Chaque variable sera validée par Zod au démarrage.
# =============================================================================

# --- Exécution ---------------------------------------------------------------

# Environnement d'exécution : development | test | production
NODE_ENV=

# Niveau de log Pino : fatal | error | warn | info | debug | trace
LOG_LEVEL=

# --- MongoDB (même base que l'API) -------------------------------------------

# [pas encore lue] Format : mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=

# --- Redis (files BullMQ, même instance que l'API) ---------------------------

# Format : redis://<user>:<password>@<host>:<port> (rediss:// pour TLS)
REDIS_URL=

# Nombre de jobs traités en parallèle par chaque file (ex. 5)
WORKER_CONCURRENCY=

# --- Chiffrement et e-mails --------------------------------------------------

# [obligatoire] Clé AES-256-GCM, la même que DATA_ENCRYPTION_KEY de l'API : le contenu des
# e-mails est chiffré dans la file d'attente. 32 octets en base64 (openssl rand -base64 32).
DATA_ENCRYPTION_KEY=

# Transport des e-mails. « file » (seul disponible) écrit chaque e-mail dans MAIL_OUTBOX_DIR :
# développement et tests seulement, refusé en production tant qu'aucun prestataire n'est choisi.
# Par défaut hors production : file
EMAIL_TRANSPORT=

# Dossier des e-mails du transport « file » (fichiers lisibles par leur seul propriétaire).
# Par défaut hors production : .mail-outbox (ignoré par git)
MAIL_OUTBOX_DIR=
