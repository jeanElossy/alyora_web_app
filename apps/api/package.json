{
  "name": "@alyora/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p jsconfig.json",
    "migrate:create": "node --env-file-if-exists=.env node_modules/migrate-mongo/bin/migrate-mongo.js create",
    "migrate:status": "node --env-file-if-exists=.env node_modules/migrate-mongo/bin/migrate-mongo.js status",
    "migrate:up": "node --env-file-if-exists=.env node_modules/migrate-mongo/bin/migrate-mongo.js up",
    "migrate:down": "node --env-file-if-exists=.env node_modules/migrate-mongo/bin/migrate-mongo.js down"
  },
  "dependencies": {
    "@alyora/shared": "workspace:*",
    "argon2": "^0.45.2",
    "bullmq": "6.7.5",
    "compression": "^1.8.2",
    "cookie": "^2.0.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "migrate-mongo": "^14.0.7",
    "mongodb": "~7.8.0",
    "mongoose": "^9.12.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "1.5.4",
    "rate-limit-redis": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@alyora/config": "workspace:*",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.2",
    "vitest": "^5.1.0"
  }
}
