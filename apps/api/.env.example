# =============================================================================
# @alyora/api - environment variables
# Copy this file to .env for local development. Never commit real values.
# Every variable will be validated with Zod at startup.
# =============================================================================

# --- Runtime -----------------------------------------------------------------

# Execution environment: development | test | production
NODE_ENV=

# HTTP port the API listens on (e.g. 3000)
PORT=

# Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=

# --- MongoDB (Atlas replica set, required for transactions) ------------------

# Format: mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=

# --- Redis (BullMQ queues, rate limiting) ------------------------------------

# Format: redis://<user>:<password>@<host>:<port> (use rediss:// for TLS)
REDIS_URL=

# --- Authentication ----------------------------------------------------------

# Secret used to sign short-lived access tokens (at least 32 random bytes, base64)
ACCESS_TOKEN_SECRET=

# Access token lifetime (e.g. 15m)
ACCESS_TOKEN_TTL=

# Refresh token lifetime (e.g. 30d). Refresh tokens are rotated on every use.
REFRESH_TOKEN_TTL=

# --- HTTP and cookies --------------------------------------------------------

# Comma-separated list of allowed browser origins (e.g. https://app.example.com)
CORS_ORIGINS=

# Domain of the refresh token cookie (e.g. .example.com). Leave empty for the current host.
COOKIE_DOMAIN=

# Public URL of the web app, used to build links sent to guests (e.g. https://app.example.com)
WEB_APP_URL=
