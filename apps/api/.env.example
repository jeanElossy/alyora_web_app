# =============================================================================
# @alyora/api - variables d'environnement
# Copier ce fichier en .env pour le développement local. Ne jamais commiter de vraie valeur.
#
# Validées par Zod au démarrage (src/config/env.schema.js) : l'API refuse de démarrer si
# une variable manque ou est invalide, et la nomme (jamais sa valeur).
#   [obligatoire]       aucune valeur par défaut, dans aucun environnement
#   [obligatoire prod]  valeur par défaut en development et test seulement, annoncée au démarrage
#   [pas encore lue]    validée par le module qui l'utilisera
# Une valeur vide compte comme absente.
# =============================================================================

# --- Exécution ---------------------------------------------------------------

# [obligatoire] Environnement d'exécution : development | test | production
NODE_ENV=

# [obligatoire prod] Port HTTP de l'API. Par défaut hors production : 3000
PORT=

# [obligatoire prod] Niveau de log Pino : fatal | error | warn | info | debug | trace | silent
# Par défaut hors production : debug (development), silent (test)
LOG_LEVEL=

# --- MongoDB (replica set obligatoire : l'API refuse un serveur standalone) ---

# [obligatoire] Format : mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Indiquer le nom de la base après l'hôte : sans lui, le driver utilise la base "test".
# En local : un replica set à un seul nœud, ex. mongodb://localhost:27017/alyora?replicaSet=rs0
MONGODB_URI=

# [obligatoire prod] Nombre maximal de connexions du pool, par instance de l'API (1-500).
# Par défaut hors production : 10. Vérifier la limite de connexions du niveau Atlas.
MONGODB_MAX_POOL_SIZE=

# --- Redis (files BullMQ, rate limiting) -------------------------------------

# [obligatoire] Format : redis://<user>:<password>@<host>:<port> (rediss:// pour TLS)
REDIS_URL=

# --- Authentification --------------------------------------------------------

# Les secrets n'ont de valeur par défaut dans AUCUN environnement. Générer chacun avec
#   openssl rand -base64 32
# et ne jamais réutiliser la même valeur pour deux variables. Les durées de vie des jetons
# (access token 15 min, refresh token 30 jours) sont des règles du projet, fixées dans
# packages/shared (constants/auth.js), et non des réglages.

# [obligatoire] Secret de signature des access tokens (HS256). Au moins 32 caractères.
# Le changer invalide les access tokens en cours ; les sessions, elles, restent valides.
ACCESS_TOKEN_SECRET=

# [obligatoire] Secret maître des empreintes à clé : IP des sessions, clés de rate limit, jetons
# CSRF, empreintes d'idempotence. Au moins 32 caractères, différent d'ACCESS_TOKEN_SECRET.
HASH_SECRET=

# [obligatoire] Clé AES-256-GCM des données chiffrées au repos (secret 2FA, contenu des e-mails
# en file d'attente) : exactement 32 octets en base64. La même valeur pour l'API et le worker.
DATA_ENCRYPTION_KEY=

# --- HTTP et cookies ---------------------------------------------------------

# [obligatoire prod] Origines navigateur autorisées, séparées par des virgules, origines exactes
# sans chemin (ex. https://app.example.com). Par défaut hors production : http://localhost:5173
CORS_ORIGINS=

# [obligatoire prod] Nombre de proxys inverses devant l'API (ex. 1 derrière un load balancer),
# ou false quand les clients l'atteignent directement. Sert à lire la vraie IP du client pour
# le rate limiting. "true" est refusé. Par défaut hors production : false
TRUST_PROXY=

# [facultatif] Domaine parent des cookies (refresh token, CSRF), ex. alyora.ci, pour que app. et
# api. les partagent. Vide : cookies limités à l'hôte de l'API.
COOKIE_DOMAIN=

# [obligatoire prod] Origine publique de l'application web, pour les liens des e-mails
# (ex. https://app.example.com). Par défaut hors production : http://localhost:5173
WEB_APP_URL=
