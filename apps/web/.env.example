# =============================================================================
# @alyora/web - variables d'environnement
# Copier ce fichier en .env.local pour le développement local.
# Seules les variables préfixées par VITE_ sont exposées au navigateur, et tout ce qui
# est exposé finit dans le JavaScript public : ne jamais mettre de secret dans ce fichier.
# =============================================================================

# URL de base de l'API, préfixe de version compris (ex. http://localhost:3000/api/v1)
VITE_API_BASE_URL=
