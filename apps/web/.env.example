# =============================================================================
# @alyora/web - environment variables
# Copy this file to .env.local for local development.
# Only variables prefixed with VITE_ are exposed to the browser, and everything
# exposed ends up in public JavaScript: never put a secret in this file.
# =============================================================================

# Base URL of the API, including the version prefix (e.g. http://localhost:3000/api/v1)
VITE_API_BASE_URL=
